{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug workspace (OpenLook)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/bin/olwm",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "OPENWINHOME",
          "value": "${workspaceFolder}/bin"
        },
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/bin/lib:${env:LD_LIBRARY_PATH}"
        },
        {
          "name": "PATH",
          "value": "${workspaceFolder}/bin/bin:${env:PATH}"
        },
        {
          "name": "DISPLAY",
          "value": ":2"
        },
        {
          "name": "XENVIRONMENT",
          "value": "${workspaceFolder}/config/Xdefaults"
        },
        {
          "name": "XV_USE_XGETVISUALINFO_ALL",
          "value": "1"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "prepare workspace (OpenLook Debug)",
      "postDebugTask": "openlook: stop session (:2)",
      "additionalSOLibSearchPath": "${workspaceFolder}/bin/lib",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug workspace (OpenLook Docker)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/docker/bin/olwm",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "prepare workspace (OpenLook Docker Debug)",
      "postDebugTask": "openlook: stop Docker session",
      "pipeTransport": {
        "pipeProgram": "bash",
        "pipeArgs": [
          "${workspaceFolder}/.vscode/openlook-docker.sh",
          "gdb"
        ],
        "debuggerPath": "/usr/bin/gdb",
        "pipeCwd": "${workspaceFolder}"
      },
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Keep ASLR enabled inside Docker",
          "text": "set disable-randomization off",
          "ignoreFailures": false
        }
      ]
    }
  ]
}
