{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake -S . -B build && cmake --build build -j\"$(nproc)\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "openlook: stop session (:2)",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/openlook-session-stop.sh",
      "problemMatcher": []
    },
    {
      "label": "prepare workspace (OpenLook Debug)",
      "type": "shell",
      "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build -j && \"${workspaceFolder}/.vscode/openlook-session-stop.sh\" && OPENLOOK_SESSION_NO_WM=1 \"${workspaceFolder}/.vscode/openlook-session-start.sh\"",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build (Docker)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/openlook-docker.sh",
        "build"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "prepare workspace (OpenLook Docker Debug)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/openlook-docker.sh",
        "prepare"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "openlook: stop Docker session",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/openlook-docker.sh",
        "stop"
      ],
      "problemMatcher": []
    }
  ]
}
